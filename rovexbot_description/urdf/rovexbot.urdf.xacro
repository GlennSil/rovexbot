<?xml version="1.0"?>

<robot name="rovexbot" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- is_ignition : Humble (Ignition) ou version récente (Gazebo Sim) -->
    <xacro:arg name="is_ignition" default="true"/>
    <!-- is_sim : true = Gazebo, false = robot réel (Arduino via port série) -->
    <xacro:arg name="is_sim" default="true"/>
    <xacro:arg name="port" default="/dev/ttyACM0"/>

    <xacro:include filename="$(find rovexbot_description)/urdf/rovexbot_gazebo.xacro" />

  <!--ros2_control plugin -->
    <xacro:include filename="$(find rovexbot_description)/urdf/rovexbot_ros2_control.xacro" />


    <!-- À REMPLACER par la masse réelle du châssis (kg) -->
    <xacro:property name="base_mass" value="1.0"/>

    <!-- Roues motrices : diamètre 65 mm, largeur 26 mm -->
    <xacro:property name="wheel_radius" value="0.0325"/>
    <xacro:property name="wheel_width" value="0.026"/>
    <!-- Décalage entre l'origine du lien de roue (face intérieure du mesh) et le centre de la roue -->
    <xacro:property name="wheel_center_offset" value="${wheel_width / 2}"/>

    <link name="base_footprint"/>

    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.01989" rpy="0 0 0"/>
            <mass value="${base_mass}"/>
            <inertia ixx="${base_mass * 0.005979}" ixy="0" ixz="0"
                    iyy="${base_mass * 0.006053}" iyz="0"
                    izz="${base_mass * 0.007788}"/>
        </inertial>

        <visual>
            <origin xyz="-0.03957301 0.04144497 0.05368166" rpy="0 0 1.57"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/Body1.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="-0.03957301 0.04144497 0.05368166" rpy="0 0 1.57"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/Body1.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0823" rpy="0 0 0"/>
    </joint>

    <!-- roue droite -->
    <link name="wheel_right_link">
        <inertial>
            <origin xyz="0 -${wheel_center_offset} 0" rpy="0 0 0"/>
            <mass value="0.0530086090966721"/>
            <inertia ixx="1.88176298336665E-05" ixy="-4.8444933029987E-10" ixz="1.88163708851143E-08"
                    iyy="3.11510738647764E-05" iyz="-6.93560663069607E-11"
                    izz="1.8801969558182E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/wheel_right_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 -${wheel_center_offset} 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_right_joint" type="continuous">
        <origin xyz="0 -0.08 -0.05" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="wheel_right_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- roue gauche -->
    <link name="wheel_left_link">
        <inertial>
            <origin xyz="0 ${wheel_center_offset} 0" rpy="0 0 0"/>
            <mass value="0.0530086043217644"/>
            <inertia ixx="1.8792911368909E-05" ixy="3.31256392204584E-10" ixz="-1.14082001662767E-08"
                    iyy="3.11510738759073E-05" iyz="-3.60499245082192E-10"
                    izz="1.88266886146847E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/wheel_left_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 ${wheel_center_offset} 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_left_joint" type="continuous">
        <origin xyz="0 0.08 -0.05" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="wheel_left_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- caster wheel avant (côté +x) : masse à remplacer par la masse réelle -->
    <link name="caster_front_link">
        <inertial>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <mass value="0.03"/>
            <inertia ixx="5e-06" ixy="0" ixz="0"
                    iyy="5e-06" iyz="0"
                    izz="5e-06"/>
        </inertial>
        <visual>
            <origin xyz="0.0038 -0.0222 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/castor_wheel_40mm_swivel.stl"
                    scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.0038 -0.0222 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/castor_wheel_40mm_swivel.stl"
                    scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="caster_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_front_link"/>
        <origin xyz="0.09 0 -0.0324" rpy="0 0 ${pi}"/>
    </joint>

    <!-- caster wheel arrière (côté -x) : masse à remplacer par la masse réelle -->
    <link name="caster_back_link">
        <inertial>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <mass value="0.03"/>
            <inertia ixx="5e-06" ixy="0" ixz="0"
                    iyy="5e-06" iyz="0"
                    izz="5e-06"/>
        </inertial>
        <visual>
            <origin xyz="0.0038 -0.0222 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/castor_wheel_40mm_swivel.stl"
                    scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.0038 -0.0222 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/castor_wheel_40mm_swivel.stl"
                    scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="caster_back_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_back_link"/>
        <origin xyz="-0.09 0 -0.0324" rpy="0 0 0"/>
    </joint>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    <material name="black">
        <color rgba="0.15 0.15 0.15 1"/>
    </material>
    <material name="silver">
        <color rgba="0.79 0.82 0.93 1"/>
    </material>
    <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
    </material>




   <link name="imu_link">
        <inertial>
        <origin xyz="-0.00552433659106688 0.000168210391520346 0.000514000497342681" rpy="0 0 0" />
        <mass value="0.000528415362211671" />
        <inertia ixx="1.46176048428261E-08" ixy="1.40015117949421E-10" ixz="-1.99633872937403E-12"
                iyy="8.59662482954888E-09" iyz="7.52375112767959E-12"
                izz="2.30279421279312E-08" />
        </inertial>
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="package://rovexbot_description/meshes/imu_link.STL" />
        </geometry>
        <material name="blue"/>
        </visual>
        <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="package://rovexbot_description/meshes/imu_link.STL" />
        </geometry>
        </collision>
   </link>

   <joint name="imu_joint" type="fixed">
        <origin xyz="0.1 0 0.056" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="imu_link" />
        <axis xyz="0 0 0" />
   </joint>


     <link name="laser_link">
        <inertial>
            <origin xyz="-0.011945780406062 -0.000381929217680526 -0.0170649378129477" rpy="0 0 0" />
            <mass value="0.073084435549317" />
            <inertia ixx="1.96074931730795E-05" ixy="-3.62091076640009E-07" ixz="4.28230084046735E-07"
                    iyy="2.40983835136327E-05" iyz="1.50180909250652E-08"
                    izz="4.14184164228595E-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/laser_link.STL" />
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://rovexbot_description/meshes/laser_link.STL" />
            </geometry>
        </collision>
     </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="-0.0050526 -0.0023221 0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser_link" />
    <axis xyz="0 0 0" />
  </joint>  






</robot>